table FactMine
	lineageTag: 17a36ff4-4d95-45f0-acb5-ee16dca9ad58

	measure 'Operating Mines' =
			
			DISTINCTCOUNT ( FactMine[MineKey] )
		formatString: 0
		lineageTag: 3bb5145c-2f9b-48a5-8c9b-e7c95ca1c4cd

	measure 'Regions Selected' =
			
			COUNTROWS ( VALUES ( DimRegion[StateCode] ) )
		formatString: 0
		lineageTag: a6ac7b78-6747-48ee-8ab9-8f4e486f6177

	measure 'Commodities Selected' =
			
			COUNTROWS ( VALUES ( DimCommodity[CommodityName] ) )
		formatString: 0
		lineageTag: 8342c367-4ad6-47d2-a8ad-06a5293ab984

	measure 'Top Commodity' =
			
			VAR CommodityCounts =
			    ADDCOLUMNS (
			        VALUES ( DimCommodity[CommodityName] ),
			        "@MineCount", [Operating Mines]
			    )
			VAR TopRow =
			    TOPN (
			        1,
			        CommodityCounts,
			        [@MineCount], DESC,
			        DimCommodity[CommodityName], ASC
			    )
			RETURN
			    CONCATENATEX (
			        TopRow,
			        DimCommodity[CommodityName],
			        ", "
			    )
		lineageTag: 143ba6b6-1c4f-48d2-9ebb-33e0150fcb82

	measure 'Map Mine Count' =
			
			COALESCE(
			    [Operating Mines],
			    0
			)
		formatString: 0
		lineageTag: b0cad1b1-7996-4c0f-86cf-5922f52bb49d

	column MineKey
		dataType: int64
		formatString: 0
		lineageTag: eee7076a-fab7-4352-98a6-11edb6912753
		summarizeBy: count
		sourceColumn: MineKey

		annotation SummarizationSetBy = Automatic

	column MineName
		dataType: string
		lineageTag: d521b807-625f-46d6-bb58-fad7eb41d53f
		summarizeBy: none
		sourceColumn: MineName

		annotation SummarizationSetBy = Automatic

	column StateCode
		dataType: string
		lineageTag: f36d67d2-4485-4c9b-bdb1-78fb4e657349
